# Copia este archivo a .env y ajusta los valores.
# En producción NUNCA uses los valores por defecto de este ejemplo.

# Base de datos (Docker: postgres)
DB_USER=stock_user
DB_PASSWORD=cambiar_password_seguro
DB_NAME=stock_db
DATABASE_URI=postgresql://stock_user:cambiar_password_seguro@localhost:5432/stock_db

# Seguridad (obligatorio en producción)
SECRET_KEY=generar-clave-secreta-larga-y-aleatoria
JWT_SECRET_KEY=

# JWT (opcional; por defecto 15 min access, 7 días refresh)
# JWT_ACCESS_TOKEN_MINUTES=15
# JWT_REFRESH_TOKEN_DAYS=7

# CORS (orígenes permitidos, separados por coma)
CORS_ORIGINS=http://localhost:3000,http://localhost:7000,http://localhost:9001

# Usuario admin inicial (solo para primer arranque / db-init)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar_admin_password

# Rate limiting con Redis (producción con Docker)
# RATELIMIT_STORAGE_URL=redis://redis:6379/0

# Entorno
# FLASK_ENV=production
# LOG_LEVEL=INFO

# Elasticsearch (si se usa)
# ELASTICSEARCH_URL=http://elasticsearch:9200
# ELASTIC_USERNAME=elastic
# ELASTIC_PASSWORD=
